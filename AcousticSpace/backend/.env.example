# ==========================================
# AcousticSpace - Environment Configuration
# ==========================================
# Copy this file to .env and update the values for your environment
# cp .env.example .env

# -----------------------------------
# Application Information
# -----------------------------------
APP_NAME=AcousticSpace API
APP_VERSION=1.0.0

# -----------------------------------
# Server Configuration
# -----------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=True

# -----------------------------------
# Paths (can be absolute or relative to BASE_DIR)
# -----------------------------------
UPLOAD_DIR=backend/uploads
FEATURE_DIR=backend/extracted_features
MODEL_DIR=backend/saved_models
LOG_DIR=backend/logs

# -----------------------------------
# AST Model Configuration
# -----------------------------------
# Path to the trained AST model directory
# Leave empty to use default: BASE_DIR/results/ast_final_model
AST_MODEL_PATH=

# Model device: cuda, mps, cpu (leave empty for auto-detection)
# Auto-detection order: CUDA > MPS (Apple Silicon) > CPU
MODEL_DEVICE=

# Model name for logging and identification
MODEL_NAME=AST

# Hugging Face model cache directory (leave empty for default)
MODEL_CACHE_DIR=

# -----------------------------------
# Database
# -----------------------------------
# SQLite database URL
DATABASE_URL=sqlite:///backend/acousticspace.db

# -----------------------------------
# File Upload Settings
# -----------------------------------
# Maximum upload size in bytes (50MB default)
MAX_UPLOAD_SIZE=52428800

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.wav,.mp3,.flac,.ogg,.m4a

# -----------------------------------
# Security
# -----------------------------------
# Change this in production!
SECRET_KEY=change-this-secret-key-in-production

# -----------------------------------
# CORS Configuration
# -----------------------------------
# Comma-separated list of allowed origins
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------
# Logging
# -----------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO